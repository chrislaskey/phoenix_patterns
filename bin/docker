#!/usr/bin/env bash
#
# Build and run the app in a local Docker container.
#
# Usage: bin/docker build   # build the image
#        bin/docker start   # build the image and run the container
#        bin/docker shell   # open a shell in the running container
#        bin/docker stop    # stop the running container
#
# Optional environment variables, read from this shell and passed to the
# container when set:
#
#   PORT              host and container port (default: 4000)
#   GIT_REPO_URL, GIT_BRANCH, GIT_TOKEN, GIT_POLL_INTERVAL
#                     watch a branch and rebuild on new commits, e.g.
#                     GIT_REPO_URL=https://github.com/org/repo \
#                     GIT_BRANCH=my-branch GIT_TOKEN=github_pat_xxx bin/docker start
#
# See docker/README.md.

set -euo pipefail

# The image and container are named after the app in mix.exs, so this script
# needs no edits when copied into another project.
app=$(sed -n 's/^ *app: :\([a-z0-9_]*\).*/\1/p' mix.exs | head -n 1)
image="$app"
container="$app"
local_env_file="docker/local.env"
port="${PORT:-4000}"

usage() {
  echo "Usage: $0 {build|start|shell|stop}" >&2
  exit 1
}

# A hex string without external tools. Not cryptographically strong, but it
# only signs cookies for a throwaway local container that nothing outside
# localhost talks to.
random_hex() {
  local length="$1" chars="0123456789abcdef" result="" i
  for ((i = 0; i < length; i++)); do
    result+="${chars:$((RANDOM % 16)):1}"
  done
  echo "$result"
}

# The release refuses to boot without SECRET_KEY_BASE (config/runtime.exs).
# This container is a throwaway local instance, so the value is a fresh
# disposable one. PHX_HOST=localhost makes the endpoint accept LiveView
# connections from a browser on localhost; a deployment sets it to its real
# host instead.
generate_local_env_file() {
  echo "Generating $local_env_file (throwaway local values, not committed)..."

  local secret_key_base
  if command -v openssl >/dev/null 2>&1; then
    secret_key_base=$(openssl rand -hex 64)
  else
    secret_key_base=$(random_hex 128)
  fi

  {
    echo "# Generated by bin/docker. Throwaway values for a local container"
    echo "# only. Never commit this file or reuse these values."
    echo "SECRET_KEY_BASE=${secret_key_base}"
    echo "PHX_HOST=localhost"
  } > "$local_env_file"
}

# git-poll.sh takes the branch tip at container start as its baseline and
# only rewrites files that change after it. The image, though, is built from
# this working tree, so if the tree does not match the watched branch the
# container runs a mix of both until every differing file is touched by a new
# commit. Warn rather than refuse: running something slightly off is still
# useful for a quick look.
warn_if_tree_differs_from_watched_branch() {
  [ -n "${GIT_BRANCH:-}" ] || return 0

  if [ -n "$(git status --porcelain 2>/dev/null)" ]; then
    echo "WARNING: working tree has uncommitted changes; the image will include them" >&2
    echo "         but git-poll will only track '$GIT_BRANCH' from its current tip." >&2
  fi

  local local_sha remote_sha
  local_sha=$(git rev-parse HEAD 2>/dev/null || true)
  remote_sha=$(git ls-remote origin "refs/heads/$GIT_BRANCH" 2>/dev/null | cut -f1 || true)
  if [ -z "$remote_sha" ]; then
    echo "WARNING: couldn't find '$GIT_BRANCH' on origin; git-poll's initial fetch may fail." >&2
  elif [ "$local_sha" != "$remote_sha" ]; then
    echo "WARNING: local HEAD ($local_sha) differs from origin/$GIT_BRANCH ($remote_sha)." >&2
    echo "         Check out and pull '$GIT_BRANCH' first so the image starts from its tip." >&2
  fi
}

[ "$#" -eq 1 ] || usage

case "$1" in
  build)
    docker build -t "$image" .
    ;;
  start)
    [ -f "$local_env_file" ] || generate_local_env_file
    warn_if_tree_differs_from_watched_branch
    docker build -t "$image" .
    # Docker's --env-file format has no quoting and cannot hold a multi-line
    # value such as a PEM key, so source the file as bash instead and hand
    # the container each value with `-e VARNAME` from this shell.
    set -a
    # shellcheck source=/dev/null
    source "$local_env_file"
    set +a
    #
    # Docker skips a bare `-e VARNAME` when VARNAME is unset, so the optional
    # git polling variables only reach the container when the caller sets
    # them.
    docker run --rm -p "${port}:${port}" \
      -e PORT="$port" \
      -e SECRET_KEY_BASE \
      -e PHX_HOST \
      -e GIT_REPO_URL \
      -e GIT_BRANCH \
      -e GIT_TOKEN \
      -e GIT_POLL_INTERVAL \
      --name "$container" "$image"
    ;;
  shell)
    docker exec -it "$container" /bin/bash
    ;;
  stop)
    docker stop "$container" 2>/dev/null || true
    docker rm -f "$container" 2>/dev/null || true
    ;;
  *)
    usage
    ;;
esac
